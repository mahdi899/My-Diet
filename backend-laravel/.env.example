APP_NAME=Sabzine
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
NODE_ENV=development
APP_ROLE=api
DB_CONNECTION=mysql
DATABASE_URL=mysql://sabzine:sabzine@127.0.0.1:3306/sabzine
# CLI rehearsal tools only; use a PostgreSQL account with SELECT permission.
# POSTGRES_SOURCE_URL=postgres://readonly:password@127.0.0.1:5432/sabzine
# Set only while migrating a new empty offline rehearsal destination, before the first migrate:
# MIGRATION_SKIP_PRODUCT_SEEDS=true
# Retain these three values from the existing backend during migration.
JWT_SECRET=dev-only-jwt-secret-not-for-production
OTP_PEPPER=dev-only-otp-pepper-not-for-production
FIELD_KEY=dev-only-field-key-not-for-production
SMS_PROVIDER=console
# Development only; ignored for test, staging and production.
# OTP_FIXED_CODE=123456
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=
MELIPAYAMAK_PATTERN_ID=
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
PAYMENT_GATEWAY=sandbox
PAYMENT_GATEWAYS=sandbox
# Test builds only. Keep false on the public server. When true, also add preview to PAYMENT_GATEWAYS.
PREVIEW_PAYMENTS=false
# Store builds: add bazaar and/or myket to PAYMENT_GATEWAYS. SKUs come from each store panel.
# BAZAAR_ACCESS_TOKEN=
# MYKET_ACCESS_TOKEN=
# BAZAAR_SKU_WEEKLY=
# BAZAAR_SKU_MONTHLY=
# BAZAAR_SKU_QUARTERLY=
# BAZAAR_SKU_NEW_PLAN=
# BAZAAR_SKU_AI_REVISION=
# BAZAAR_SKU_SPECIALIST_REVISION=
# MYKET_SKU_WEEKLY=
# MYKET_SKU_MONTHLY=
# MYKET_SKU_QUARTERLY=
# MYKET_SKU_NEW_PLAN=
# MYKET_SKU_AI_REVISION=
# MYKET_SKU_SPECIALIST_REVISION=
PUBLIC_API_URL=http://127.0.0.1:8000
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZIBAL_MERCHANT=
# Development/integration tests only:
# ZARINPAL_BASE_URL=http://127.0.0.1:9999
LOG_CHANNEL=single
LOG_LEVEL=warning
# Comma-separated browser origins. Empty outside production allows the requesting origin.
CORS_ORIGINS=
# Leave both empty to keep web analytics at 503 analytics_unavailable.
ANALYTICS_DATABASE_URL=
ANALYTICS_WEBSITE_ID=
# Set true after configuring provider keys and model pools in the admin panel.
# HTTP adapters fail closed when disabled; test doubles are selected only by tests.
AI_HTTP=false
# Used by `php artisan sabzine:wire-ai` to store Closerouter and OpenRouter in the admin panel.
CLOSEROUTER_BASE_URL=https://api.closerouter.dev/v1
CLOSEROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
AI_ALLOW_PRIVATE_ENDPOINTS=false
