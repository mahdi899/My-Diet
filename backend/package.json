{
  "name": "sabzine-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sabzine API and worker.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --import tsx --test test/unit/foundation.spec.ts test/unit/phase1.spec.ts test/unit/phase2.spec.ts test/unit/phase3.spec.ts test/unit/phase4.spec.ts",
    "test:integration": "npm run build && node --import tsx --test --test-concurrency=1 test/integration/phase0.spec.ts test/integration/phase1.spec.ts test/integration/phase2.spec.ts test/integration/phase3.spec.ts test/integration/phase4.spec.ts",
    "migrate": "node-pg-migrate -f node-pg-migrate.json up",
    "migrate:down": "node-pg-migrate -f node-pg-migrate.json down",
    "admin:create": "node --import tsx src/cli/create-admin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@sentry/node": "^11.9.0",
    "kysely": "^0.29.7",
    "nestjs-pino": "^5.3.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
