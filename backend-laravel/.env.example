APP_NAME=Sabzine
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
NODE_ENV=development
APP_ROLE=api
DB_CONNECTION=pgsql
DATABASE_URL=postgres://sabzine:sabzine@127.0.0.1:5432/sabzine
# Retain these three values from the existing backend during migration.
JWT_SECRET=dev-only-jwt-secret-not-for-production
OTP_PEPPER=dev-only-otp-pepper-not-for-production
FIELD_KEY=dev-only-field-key-not-for-production
SMS_PROVIDER=console
# Development only; ignored for test, staging and production.
# OTP_FIXED_CODE=123456
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=
MELIPAYAMAK_PATTERN_ID=
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
