    <item name="android:windowBackground">@drawable/launch_background</item>
    <item name="android:windowSplashScreenBackground">@color/sabzine_splash_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/startup_transparent</item>
    <item name="android:windowSplashScreenAnimationDuration">0</item>
